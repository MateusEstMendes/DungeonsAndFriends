{
  "name": "dungeons-and-friends",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:combat": "vitest run packages/shared/src/combat apps/server/tests/combat.test.ts apps/server/tests/dice.test.ts",
    "test:combat-sim": "pnpm --filter @df/shared build && pnpm --filter @df/server test:combat-sim",
    "dev": "pnpm --filter @df/shared build && pnpm --parallel --filter @df/client --filter @df/server run dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @df/server db:generate",
    "db:migrate": "pnpm --filter @df/server db:migrate",
    "db:studio": "pnpm --filter @df/server db:studio",
    "start:host": "pnpm build && pnpm --filter @df/server start:host",
    "db:sanitize": "pnpm --filter @df/server db:sanitize",
    "audio:build": "node scripts/build-audio-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "ffmpeg-static": "^5.3.0",
    "lighthouse": "^13.6.0",
    "typescript": "~5.7.3",
    "vitest": "^4.0.0"
  }
}
