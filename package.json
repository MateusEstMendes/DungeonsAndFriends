{
  "name": "dungeons-and-friends",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @df/shared build && pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @df/server db:generate",
    "db:migrate": "pnpm --filter @df/server db:migrate",
    "db:studio": "pnpm --filter @df/server db:studio",
    "start:host": "pnpm build && pnpm --filter @df/server start:host"
  },
  "devDependencies": {
    "typescript": "~5.7.3",
    "vitest": "^4.0.0",
    "@types/node": "^24.0.0"
  }
}
